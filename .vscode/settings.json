{
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "pylint.args": [
        "--rcfile=pyproject.toml",
        "--disable=too-few-public-methods,missing-function-docstring"
    ],
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "cSpell.words": [
        "allclose",
        "arccos",
        "arctan",
        "bary",
        "broadcastability",
        "broadcastable",
        "gmsh",
        "keepdim",
        "keepdims",
        "LBFGS",
        "linalg",
        "localdata",
        "lowrank",
        "maxs",
        "meshio",
        "optims",
        "PCANN",
        "PINN",
        "popleft",
        "qewton",
        "randperm",
        "Sobol",
        "submesh",
        "TUNABLEPARAMS",
        "vecs"
    ]
}
